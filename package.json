{
    "name": "aljazmc",
    "version": "0.4.2",
    "description": "Lightweight NPM packages, written in modern TypeScript.",
    "author": "aljazmc",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/aljazmc/aljazmc.git"
    },
    "packageManager": "yarn@4.18.1",
    "engines": {
        "node": "^22.18.0 || ^24.2.0 || ^25 || ^26",
        "npm": "Please use yarn instead of NPM to install dependencies",
        "pnpm": "Please use yarn instead of PNPM to install dependencies",
        "yarn": ">=4.12.0"
    },
    "workspaces": [
        "packages/**",
        "shared/*"
    ],
    "scripts": {
        "b:all": "yarn b:config && yarn b:syntax && yarn b:formatero && yarn b:lintero && yarn b:monorepo && yarn b:testero",
        "b:config": "esbuild shared/config/src/index.ts --bundle --keep-names --platform=node --format=esm --target=esnext --outdir=shared/config/bin/",
        "b:formatero": "esbuild packages/formatero/src/main.ts --bundle --keep-names --platform=node --format=esm --target=esnext --outdir=packages/formatero/bin/",
        "b:lintero": "esbuild packages/lintero/src/main.ts --bundle --keep-names --platform=node --format=esm --target=esnext --outdir=packages/lintero/bin/",
        "b:monorepo": "esbuild packages/monorepo/src/main.ts --bundle --keep-names --platform=node --format=esm --target=esnext --outdir=packages/monorepo/bin/",
        "b:syntax": "esbuild shared/syntax/src/index.ts --bundle --keep-names --platform=node --format=esm --target=esnext --outdir=shared/syntax/bin/",
        "b:testero": "esbuild packages/testero/src/main.ts --bundle --keep-names --platform=node --format=esm --target=esnext --external:esbuild --outdir=packages/testero/bin/",
        "c:all": "yarn c:config && yarn c:syntax && yarn c:formatero && yarn c:lintero && yarn c:monorepo && yarn c:testero",
        "c:config": "yarn l:config && yarn t:config && yarn b:config && yarn et:config",
        "c:formatero": "yarn l:formatero && yarn t:formatero && yarn b:formatero && yarn et:formatero",
        "c:lintero": "yarn l:lintero && yarn t:lintero && yarn b:lintero && yarn et:lintero",
        "c:monorepo": "yarn l:monorepo && yarn t:monorepo && yarn b:monorepo && yarn et:monorepo",
        "c:syntax": "yarn l:syntax && yarn t:syntax && yarn b:syntax && yarn et:syntax",
        "c:testero": "yarn l:testero && yarn t:testero && yarn b:testero && yarn et:testero",
        "ct:all": "yarn ct:config && yarn ct:syntax && yarn ct:formatero && yarn ct:lintero && yarn ct:monorepo && yarn ct:testero",
        "ct:config": "tsc --noEmit --project shared/config/tsconfig.json",
        "ct:formatero": "tsc --noEmit --project packages/formatero/tsconfig.json",
        "ct:lintero": "tsc --noEmit --project packages/lintero/tsconfig.json",
        "ct:monorepo": "tsc --noEmit --project packages/monorepo/tsconfig.json",
        "ct:syntax": "tsc --noEmit --project shared/syntax/tsconfig.json",
        "ct:testero": "tsc --noEmit --project packages/testero/tsconfig.json",
        "et:all": "tsc -b shared/config shared/syntax packages/formatero packages/lintero packages/monorepo packages/testero",
        "et:config": "tsc -b shared/config",
        "et:formatero": "tsc -b packages/formatero",
        "et:lintero": "tsc -b packages/lintero",
        "et:monorepo": "tsc -b packages/monorepo",
        "et:syntax": "tsc -b shared/syntax",
        "et:testero": "tsc -b packages/testero",
        "l:all": "biome check",
        "l:config": "biome check shared/config",
        "l:formatero": "biome check packages/formatero",
        "l:lintero": "biome check packages/lintero",
        "l:monorepo": "biome check packages/monorepo",
        "l:syntax": "biome check shared/syntax",
        "l:testero": "biome check packages/testero",
        "lw:all": "biome check --write",
        "lw:formatero": "biome check packages/formatero --write",
        "lw:lintero": "biome check packages/lintero --write",
        "lw:monorepo": "biome check packages/monorepo --write",
        "lw:testero": "biome check packages/testero --write",
        "lwu:all": "biome check --write --unsafe",
        "lwu:formatero": "biome check packages/formatero --write --unsafe",
        "lwu:lintero": "biome check packages/lintero --write --unsafe",
        "lwu:monorepo": "biome check packages/monorepo --write --unsafe",
        "lwu:testero": "biome check packages/testero --write --unsafe",
        "p:all": "yarn workspaces foreach -At --no-private --topological npm publish --access public --tolerate-republish",
        "p:config": "yarn workspace @aljazmc/config npm publish --access public --tolerate-republish",
        "p:formatero": "yarn workspace @aljazmc/formatero npm publish --access public --tolerate-republish",
        "p:lintero": "yarn workspace @aljazmc/lintero npm publish --access public --tolerate-republish",
        "p:monorepo": "yarn workspace @aljazmc/monorepo npm publish --access public --tolerate-republish",
        "p:syntax": "yarn workspace @aljazmc/syntax npm publish --access public --tolerate-republish",
        "p:testero": "yarn workspace @aljazmc/testero npm publish --access public --tolerate-republish",
        "t:all": "yarn test",
        "t:coverage": "yarn t:all --coverage",
        "t:config": "jest shared/config",
        "t:formatero": "jest packages/formatero",
        "t:lintero": "jest packages/lintero",
        "t:monorepo": "jest packages/monorepo",
        "t:syntax": "jest shared/syntax",
        "t:testero": "jest packages/testero",
        "te2e:formatero": "jest packages/formatero/tests/e2e",
        "te2e:lintero": "jest packages/lintero/tests/e2e",
        "te2e:monorepo": "jest packages/monorepo/tests/e2e",
        "te2e:testero": "jest packages/testero/tests/e2e",
        "tunit:formatero": "jest packages/formatero/tests/unit",
        "tunit:lintero": "jest packages/lintero/tests/unit",
        "tunit:monorepo": "jest packages/monorepo/tests/unit",
        "tunit:testero": "jest packages/testero/tests/unit",
        "test": "jest",
        "test:w": "jest --watchAll",
        "typecheck:w": "tsc --noEmit --watch"
    },
    "dependencies": {
        "@aljazmc/formatero": "workspace:*",
        "@aljazmc/lintero": "workspace:*",
        "@aljazmc/monorepo": "workspace:*",
        "@aljazmc/testero": "workspace:*"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.2",
        "@jest/globals": "^30.5.2",
        "@types/node": "^26.6.5",
        "esbuild": "0.28.2",
        "esbuild-register": "^3.6.0",
        "jest": "^30.5.2",
        "jest-esbuild": "^0.4.0",
        "typescript": "^7.0.2",
        "unrs-resolver": "^1.12.2"
    },
    "resolutions": {
        "esbuild": "0.28.2",
        "unrs-resolver": "1.12.2"
    }
}
