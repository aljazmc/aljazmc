{
    "name": "@aljazmc/formatero",
    "version": "0.5.0",
    "description": "A simple formatter for JavaScript, TypeScript, JSX, JSON and Markdown. Easy to understand, easy to customize and easy to extend.",
    "author": "aljazmc",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/aljazmc/aljazmc.git",
        "directory": "packages/formatero"
    },
    "keywords": [
        "customizable",
        "formatter",
        "typescript",
        "modern",
        "modular"
    ],
    "engines": {
        "node": "^22.18.0 || ^24.2.0 || ^25 || ^26"
    },
    "types": "./bin/types/formatero.d.ts",
    "bin": "./bin/main.js",
    "exports": {
        ".": {
            "types": "./bin/types/formatero.d.ts",
            "default": "./bin/main.js"
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@aljazmc/config": "workspace:^",
        "@aljazmc/syntax": "workspace:^"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@types/node": "^26.6.5"
    }
}
