{
    "name": "@aljazmc/lintero",
    "version": "0.9.0",
    "description": "A simple linter for JavaScript, TypeScript, JSX, JSON, Markdown, HTML and CSS, with 287 rules and automatic fixes. Easy to understand, easy to customize and easy to extend.",
    "author": "aljazmc",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/aljazmc/aljazmc.git",
        "directory": "packages/lintero"
    },
    "keywords": [
        "customizable",
        "linter",
        "typescript",
        "modern",
        "modular"
    ],
    "engines": {
        "node": "^22.18.0 || ^24.2.0 || ^25 || ^26"
    },
    "types": "./bin/types/lintero.d.ts",
    "bin": "./bin/main.js",
    "exports": {
        ".": {
            "types": "./bin/types/lintero.d.ts",
            "default": "./bin/main.js"
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@aljazmc/config": "workspace:^",
        "@aljazmc/syntax": "workspace:^"
    },
    "devDependencies": {
        "@types/node": "^26.6.6"
    }
}
