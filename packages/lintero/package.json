{
    "name": "@aljazmc/lintero",
    "version": "0.9.0",
    "description": "A simple, dependency-free linter for CSS, HTML, JavaScript, JSON, JSX, Markdown and TypeScript, with 287 rules, automatic fixes and organized imports. Biome 2.6.6 compatible.",
    "author": "aljazmc",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/aljazmc/aljazmc.git",
        "directory": "packages/lintero"
    },
    "keywords": [
        "linter",
        "lint",
        "static analysis",
        "autofix",
        "organize imports",
        "javascript",
        "typescript",
        "jsx",
        "json",
        "css",
        "html",
        "markdown",
        "accessibility",
        "zero-dependency"
    ],
    "engines": {
        "node": "^22.18.0 || ^24.2.0 || ^25 || ^26"
    },
    "types": "./bin/types/lintero.d.ts",
    "bin": "./bin/main.js",
    "exports": {
        ".": {
            "types": "./bin/types/lintero.d.ts",
            "default": "./bin/main.js"
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@aljazmc/config": "workspace:^",
        "@aljazmc/syntax": "workspace:^"
    },
    "devDependencies": {
        "@types/node": "^26.6.6"
    }
}
