{
    "name": "@aljazmc/monorepo",
    "version": "0.5.4",
    "description": "A simple, dependency-free monorepo release tool that versions each package on its own by conventional commits and moves the tags a rebase left behind.",
    "author": "aljazmc",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/aljazmc/aljazmc.git",
        "directory": "packages/monorepo"
    },
    "keywords": [
        "monorepo",
        "release",
        "versioning",
        "semver",
        "conventional commits",
        "git tags",
        "rebase",
        "workspaces",
        "zero-dependency"
    ],
    "engines": {
        "node": "^22.18.0 || ^24.2.0 || ^25 || ^26"
    },
    "types": "./bin/types/monorepo.d.ts",
    "bin": "./bin/main.js",
    "exports": {
        ".": {
            "types": "./bin/types/monorepo.d.ts",
            "default": "./bin/main.js"
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@aljazmc/config": "workspace:^"
    },
    "devDependencies": {
        "@types/node": "^26.6.6"
    }
}
