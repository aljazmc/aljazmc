{
    "name": "@aljazmc/testero",
    "version": "0.4.0",
    "description": "A simple, Jest-like test runner for JavaScript, TypeScript and JSX, compiling tests with esbuild. Easy to understand, easy to customize and easy to extend.",
    "author": "aljazmc",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/aljazmc/aljazmc.git",
        "directory": "packages/testero"
    },
    "keywords": [
        "customizable",
        "jest",
        "test runner",
        "tester",
        "typescript",
        "modern",
        "modular"
    ],
    "engines": {
        "node": "^22.18.0 || ^24.2.0 || ^25 || ^26"
    },
    "types": "./bin/types/testero.d.ts",
    "bin": "./bin/main.js",
    "exports": {
        ".": {
            "types": "./bin/types/testero.d.ts",
            "default": "./bin/main.js"
        },
        "./globals": {
            "types": "./bin/types/ambient.d.ts"
        },
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@types/node": "^26.6.5"
    },
    "dependencies": {
        "@aljazmc/config": "workspace:^",
        "esbuild": "0.28.2"
    }
}
