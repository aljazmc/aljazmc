{
    "name": "@aljazmc/syntax",
    "version": "0.4.0",
    "description": "Shared, dependency-free JavaScript, TypeScript, JSX, JSON and Markdown parser for @aljazmc packages.",
    "author": "aljazmc",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/aljazmc/aljazmc.git",
        "directory": "shared/syntax"
    },
    "engines": {
        "node": "^22.18.0 || ^24.2.0 || ^25 || ^26"
    },
    "types": "./bin/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./bin/types/index.d.ts",
            "default": "./src/index.ts"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./bin/types/index.d.ts",
                "default": "./bin/index.js"
            },
            "./package.json": "./package.json"
        }
    },
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@types/node": "^26.6.5"
    }
}
